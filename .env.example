# Pick ONE or BOTH. Never commit your real .env.

# DigitalOcean serverless inference (Gemma 4). Control Panel > Serverless inference > Model Access Keys
DIGITALOCEAN_MODEL_ACCESS_KEY=

# Gemini API (Gemma 4). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Both keys set => "hybrid": solving/eval on DigitalOcean (fast), skill-writing on the Gemini API.
# GROVE_PROVIDER=hybrid         # gemini | digitalocean | hybrid
# GROVE_DO_MODEL=gemma-4-31B-it # confirm with: python -m grove models
# GROVE_MODEL=gemma-4-31b-it
# GROVE_FALLBACK_MODEL=gemma-4-26b-a4b-it
# GROVE_MIN_GAP=4.5             # Gemini free tier is ~15 req/min
# GROVE_DO_MIN_GAP=0.6
# GROVE_EVAL_WORKERS=4          # parallel eval calls (default 4 on DO/hybrid, 1 on Gemini)
# GROVE_MODE=auto               # auto | live | replay | mock
